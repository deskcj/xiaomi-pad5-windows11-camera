; Root-enumerated AVStream frontend for the Xiaomi Pad 5 rear OV13B10.

[Version]
Signature="$WINDOWS NT$"
Class=Camera
ClassGuid={ca3e7ab9-b4c3-4ae6-8251-579ef933890f}
Provider=%ProviderName%
DriverVer=09/22/2026,226.3.0.4
CatalogFile=nabucamavstreamrearvirtual.cat
PnpLockdown=1

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
NabuCamAvStreamRearVirtual.sys=1

[DestinationDirs]
Rear.CopyFiles=13

[Manufacturer]
%ProviderName%=Standard,NTarm64.10.0...16299

[Standard.NTarm64.10.0...16299]
%DeviceDesc%=Rear.Device,ROOT\NABUCAMVIRTUALREAR

[Rear.Device.NT]
Include=ks.inf,kscaptur.inf
Needs=KS.Registration,KSCAPTUR.Registration.NT
CopyFiles=Rear.CopyFiles

[Rear.CopyFiles]
NabuCamAvStreamRearVirtual.sys

[Rear.Device.NT.Services]
AddService=NabuCamAvStreamRearVirtual,0x00000002,Rear.Service

[Rear.Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NabuCamAvStreamRearVirtual.sys

[Rear.Device.NT.Wdf]
KmdfService=NabuCamAvStreamRearVirtual,Rear.Wdf

[Rear.Wdf]
KmdfLibraryVersion=1.15

[Rear.Device.NT.Interfaces]
AddInterface=%KSCATEGORY_VIDEO_CAMERA%,%RearFilterGuid%,Rear.Interface
AddInterface=%KSCATEGORY_CAPTURE%,%RearFilterGuid%,Rear.CaptureInterface

[Rear.Interface]
AddReg=Rear.Interface.AddReg

[Rear.Interface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyName%
HKR,,Description,,%FriendlyName%

[Rear.CaptureInterface]
AddReg=Rear.CaptureInterface.AddReg

[Rear.CaptureInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyName%
HKR,,Description,,%FriendlyName%

[Strings]
ProviderName="nabu-camera-project"
DeviceDesc="Xiaomi Pad 5 Rear Camera"
FriendlyName="Xiaomi Pad 5 Rear Camera"
ServiceName="NabuCamAvStreamRearVirtual"
DiskName="Nabu Rear Virtual Camera Driver Disk"
KSCATEGORY_VIDEO_CAMERA="{E5323777-F976-4F5B-9B55-B94699C46E44}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
RearFilterGuid="{917C6D16-EC9A-4BB1-A1E7-EC373B770139}"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
