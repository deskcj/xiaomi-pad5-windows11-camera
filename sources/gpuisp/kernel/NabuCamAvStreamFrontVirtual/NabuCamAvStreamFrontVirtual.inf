; Root-enumerated AVStream frontend for the Xiaomi Pad 5 front OV8856.

[Version]
Signature="$WINDOWS NT$"
Class=Camera
ClassGuid={ca3e7ab9-b4c3-4ae6-8251-579ef933890f}
Provider=%ProviderName%
DriverVer=10/15/2026,227.1.0.10
CatalogFile=nabucamavstreamfrontvirtual.cat
PnpLockdown=1

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
NabuCamAvStreamFrontVirtual.sys=1

[DestinationDirs]
Front.CopyFiles=13

[Manufacturer]
%ProviderName%=Standard,NTarm64.10.0...16299

[Standard.NTarm64.10.0...16299]
%DeviceDesc%=Front.Device,ROOT\NABUCAMVIRTUALFRONT

[Front.Device.NT]
Include=ks.inf,kscaptur.inf
Needs=KS.Registration,KSCAPTUR.Registration.NT
CopyFiles=Front.CopyFiles

[Front.CopyFiles]
NabuCamAvStreamFrontVirtual.sys

[Front.Device.NT.Services]
AddService=NabuCamAvStreamFrontVirtual,0x00000002,Front.Service

[Front.Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NabuCamAvStreamFrontVirtual.sys

[Front.Device.NT.Wdf]
KmdfService=NabuCamAvStreamFrontVirtual,Front.Wdf

[Front.Wdf]
KmdfLibraryVersion=1.15

[Front.Device.NT.Interfaces]
AddInterface=%KSCATEGORY_VIDEO_CAMERA%,%FrontFilterGuid%,Front.Interface
AddInterface=%KSCATEGORY_CAPTURE%,%FrontFilterGuid%,Front.CaptureInterface

[Front.Interface]
AddReg=Front.Interface.AddReg

[Front.Interface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyName%
HKR,,Description,,%FriendlyName%

[Front.CaptureInterface]
AddReg=Front.CaptureInterface.AddReg

[Front.CaptureInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyName%
HKR,,Description,,%FriendlyName%

[Strings]
ProviderName="nabu-camera-project"
DeviceDesc="Xiaomi Pad 5 Front Camera"
FriendlyName="Xiaomi Pad 5 Front Camera"
ServiceName="NabuCamAvStreamFrontVirtual"
DiskName="Nabu Front Virtual Camera Driver Disk"
KSCATEGORY_VIDEO_CAMERA="{E5323777-F976-4F5B-9B55-B94699C46E44}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
FrontFilterGuid="{1C737E6B-D690-4662-89AD-EBD718C48B7C}"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"

